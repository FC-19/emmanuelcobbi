---
import { Image } from "astro:assets";
import { assets } from "../content/assets";
import { tribe } from "../content/site";

const screens = [
  assets.tribePersonal,
  assets.tribeVendor,
  assets.tribeTia,
  assets.tribeMarket,
  assets.tribeWallet,
  assets.tribeOrders,
  assets.tribeEarnings,
  assets.tribeAffiliate,
  assets.tribeLiveMobile,
];
---

<section class="section section--ink tribe-section" id="triber" data-theme="ink">
  <div class="shell tribe-shell">
    <div class="tribe-copy" data-reveal>
      <p class="eyebrow">{tribe.eyebrow}</p>
      <h2 class="display-2 tribe-title">{tribe.title}</h2>
      <p class="tribe-supporting">{tribe.supporting}</p>
      <p class="tribe-description">{tribe.description}</p>

      <div class="tribe-tags" aria-label="Triber capabilities">
        {tribe.values.map((value) => <span>{value.title}</span>)}
      </div>

      <div class="actions tribe-actions">
        <a class="pill pill--light" href={tribe.cta.href} rel="noopener">{tribe.cta.label}</a>
        <span class="tribe-site">{tribe.site}</span>
      </div>
    </div>

    <div class="tribe-visual" data-reveal style="--reveal-delay:0.08s">
      <div class="tribe-wordmark">
        <Image src={assets.tribeIcon.src} alt="" widths={[48, 96]} sizes="32px" aria-hidden="true" />
        <span>triber</span>
      </div>
      <div class="tribe-phone" data-tribe-phone aria-label="Animated Triber app screens">
        <span class="tribe-phone__notch" aria-hidden="true"></span>
        <div class="tribe-phone__screens">
          {
            screens.map((screen, index) => (
              <Image
                class:list={["tribe-phone__screen", index === 0 && "is-active"]}
                src={screen.src}
                alt={screen.alt}
                widths={[240, 360, 520]}
                sizes="(min-width: 900px) 16rem, 64vw"
                loading={index === 0 ? "eager" : "lazy"}
              />
            ))
          }
        </div>
      </div>
      <div class="tribe-caption">
        <span data-tribe-caption>Personal</span>
        <span>App preview</span>
        <button type="button" data-tribe-reel-toggle aria-pressed="false">Pause reel</button>
      </div>
    </div>
  </div>
</section>

<style>
  .tribe-section {
    min-height: 0;
    padding-block: clamp(3.5rem, 6vw, 5.5rem);
  }

  .tribe-shell {
    display: grid;
    gap: clamp(3rem, 6vw, 6rem);
    align-items: center;
  }

  .tribe-title {
    max-width: 10ch;
    margin-top: 1rem;
  }

  .tribe-supporting {
    margin-top: 0.8rem;
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 2.2vw, 1.65rem);
    letter-spacing: -0.03em;
    color: #bdbdbd;
  }

  .tribe-description {
    max-width: 54ch;
    margin-top: 1.2rem;
    color: #b4b4b4;
    line-height: 1.7;
  }

  .tribe-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.42rem;
    margin-top: 1.5rem;
  }

  .tribe-tags span {
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 999px;
    padding: 0.36rem 0.75rem;
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.03em;
    color: #d8d8d8;
  }

  .tribe-actions {
    margin-top: 1.7rem;
  }

  .tribe-visual {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    min-height: 34rem;
    justify-content: flex-end;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 28px;
    background:
      radial-gradient(circle at 50% 25%, rgba(255, 255, 255, 0.1), transparent 36%),
      #0b0b0b;
  }

  .tribe-wordmark {
    position: absolute;
    top: 1.7rem;
    left: 1.7rem;
    z-index: 2;
    display: flex;
    align-items: center;
    gap: 0.7rem;
  }

  .tribe-wordmark > img {
    width: 2rem;
  }

  .tribe-wordmark span {
    font-family: var(--font-display);
    font-size: 1.45rem;
    font-weight: 650;
    letter-spacing: -0.06em;
    color: #f7f2ea;
  }

  .tribe-site {
    font-family: var(--font-mono);
    font-size: 0.64rem;
    letter-spacing: 0.04em;
    color: #9b9b9b;
    text-transform: uppercase;
  }

  .tribe-phone {
    position: relative;
    z-index: 1;
    width: min(64vw, 18.5rem);
    overflow: hidden;
    border: 1px solid #555;
    border-radius: 2.4rem;
    padding: 0.45rem;
    background: #050505;
    box-shadow: 0 40px 80px rgba(0, 0, 0, 0.65);
    transform: rotate(-2deg);
    animation: tribe-phone-float 6s ease-in-out infinite alternate;
  }

  .tribe-phone__notch {
    position: absolute;
    z-index: 4;
    top: 0.75rem;
    left: 50%;
    width: 31%;
    height: 0.75rem;
    transform: translateX(-50%);
    border-radius: 999px;
    background: #050505;
  }

  .tribe-phone__screens {
    position: relative;
    aspect-ratio: 0.462;
    overflow: hidden;
    border-radius: 2rem;
    background: #f7f7f5;
  }

  .tribe-phone__screen {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
    opacity: 0;
    visibility: hidden;
    clip-path: inset(0);
    transition: opacity 0.4s ease;
  }

  .tribe-phone__screen.is-active {
    opacity: 1;
    visibility: visible;
  }

  .tribe-caption {
    position: relative;
    z-index: 2;
    display: flex;
    width: min(72vw, 22rem);
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.55rem;
    margin: 1rem 0 1.35rem;
    font-family: var(--font-mono);
    font-size: 0.58rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: #8a8a8a;
  }

  .tribe-caption button {
    border: 1px solid rgba(255, 255, 255, 0.22);
    border-radius: 999px;
    padding: 0.28rem 0.65rem;
    background: transparent;
    color: #c8c8c8;
    font: inherit;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    cursor: pointer;
  }

  .tribe-caption button:hover {
    border-color: rgba(255, 255, 255, 0.48);
    color: #fff;
  }

  @keyframes tribe-phone-float {
    to {
      transform: rotate(1.5deg) translateY(-8px);
    }
  }

  @media (min-width: 850px) {
    .tribe-shell {
      grid-template-columns: minmax(0, 1fr) minmax(22rem, 0.68fr);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .tribe-phone {
      animation: none;
    }
  }
</style>
