---
import { Image } from "astro:assets";
import { assets } from "../content/assets";
import { journalSlides } from "../content/site";
---

<section class="section section--ink journal" id="journal" data-theme="ink">
  <div class="shell">
    <div class="journal-card" data-journal data-reveal>
      <div class="journal-card__head">
        <p class="eyebrow">Journal</p>
        <p>
          <span>Hi, I’m Emmanuel</span>
          <span aria-hidden="true">·</span>
          <span data-journal-count>1 / {journalSlides.length}</span>
        </p>
      </div>

      <div class="journal-stage" role="region" aria-roledescription="carousel" aria-label="Emmanuel Cobbi journal">
        {
          journalSlides.map((slide, index) => {
            const image = assets[slide.image];
            return (
              <figure
                class:list={["journal-slide", index === 0 && "is-active"]}
                data-journal-slide
                aria-hidden={index === 0 ? "false" : "true"}
              >
                <Image
                  src={image.src}
                  alt={image.alt}
                  widths={[360, 560, 780]}
                  sizes="(min-width: 900px) 34rem, 78vw"
                  loading={index === 0 ? "eager" : "lazy"}
                  style={`object-position:${slide.position}`}
                />
                <figcaption>
                  <span>{slide.caption}</span>
                  <span>0{index + 1}</span>
                </figcaption>
              </figure>
            );
          })
        }
      </div>

      <div class="journal-controls">
        <button type="button" data-journal-prev aria-label="Previous journal image">←</button>
        <button type="button" data-journal-toggle aria-pressed="false">
          <span aria-hidden="true">Ⅱ</span>
          <span class="sr-only">Pause journal rotation</span>
        </button>
        <button type="button" data-journal-next aria-label="Next journal image">→</button>
      </div>
    </div>
  </div>
</section>

<style>
  .journal {
    padding-block: clamp(3rem, 6vw, 5rem);
  }

  .journal-card {
    position: relative;
    overflow: hidden;
    border-radius: 28px;
    padding: clamp(1.5rem, 4vw, 3rem);
    background: #050505;
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.08);
  }

  .journal-card__head {
    text-align: center;
  }

  .journal-card__head .eyebrow {
    color: #f7f7f7;
    font-size: 1.7rem;
    letter-spacing: -0.04em;
    text-transform: none;
  }

  .journal-card__head p:last-child {
    display: flex;
    justify-content: center;
    gap: 0.5rem;
    margin-top: 0.35rem;
    font-family: var(--font-mono);
    font-size: 0.66rem;
    color: #8d8d8d;
  }

  .journal-stage {
    position: relative;
    height: clamp(26rem, 54vw, 36rem);
    margin-top: 1.7rem;
    perspective: 1500px;
    transform-style: preserve-3d;
  }

  .journal-slide {
    --offset: 0;
    --abs: 0;
    --rotate: 0deg;
    position: absolute;
    top: 50%;
    left: 50%;
    width: min(62vw, 34rem);
    margin: 0;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 8px;
    background: #151515;
    opacity: calc(1 - min(var(--abs), 2) * 0.22);
    transform:
      translate(-50%, -50%)
      translateX(calc(var(--offset) * 51%))
      translateZ(calc(var(--abs) * -110px))
      rotateY(calc(var(--offset) * -22deg + var(--rotate)))
      scale(calc(1 - min(var(--abs), 2) * 0.08));
    transform-origin: center;
    transition:
      transform 0.7s var(--ease),
      opacity 0.5s ease;
    pointer-events: none;
  }

  .journal-slide.is-active {
    z-index: 3;
    opacity: 1;
    pointer-events: auto;
  }

  .journal-slide img {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
  }

  .journal-slide figcaption {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.85rem 0.95rem;
    font-family: var(--font-mono);
    font-size: 0.62rem;
    color: #c8c8c8;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .journal-controls {
    position: relative;
    z-index: 5;
    display: flex;
    justify-content: center;
    gap: 0.55rem;
    margin-top: 1rem;
  }

  .journal-controls button {
    display: grid;
    width: 3rem;
    aspect-ratio: 1;
    place-items: center;
    border: 1px solid rgba(255, 255, 255, 0.18);
    border-radius: 50%;
    background: #1d1d1d;
    color: #f7f7f7;
    cursor: pointer;
    transition:
      transform 0.25s var(--ease),
      background-color 0.25s ease;
  }

  .journal-controls button:hover {
    transform: translateY(-2px);
    background: #2b2b2b;
  }

  .journal-controls button[aria-pressed="true"] span:first-child {
    font-size: 0;
  }

  .journal-controls button[aria-pressed="true"] span:first-child::after {
    content: "▶";
    font-size: 0.8rem;
  }

  :global(.no-js) .journal-stage {
    display: flex;
    height: auto;
    gap: 1rem;
    overflow-x: auto;
  }

  :global(.no-js) .journal-slide {
    position: relative;
    top: auto;
    left: auto;
    flex: 0 0 min(78vw, 24rem);
    opacity: 1;
    transform: none;
    pointer-events: auto;
  }

  :global(.no-js) .journal-controls {
    display: none;
  }

  @media (max-width: 620px) {
    .journal-card {
      margin-inline: calc(var(--pad) * -0.45);
    }

    .journal-slide {
      width: min(78vw, 23rem);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .journal-slide {
      transition: none;
    }
  }
</style>
