---
import { Image } from "astro:assets";
import { assets } from "../content/assets";
import { book } from "../content/site";
---

<section class="section section--blue book-section" id="book" data-theme="blue">
  <div class="shell book-feature">
    <div class="book-feature__art" data-reveal>
        <Image
          src={assets.bookMockup.src}
          alt={assets.bookMockup.alt}
          widths={[240, 360, 520]}
          sizes="(min-width: 900px) 17rem, 58vw"
          loading="lazy"
        />
    </div>

    <div class="book-feature__text" data-reveal style="--reveal-delay:0.1s">
      <p class="eyebrow">{book.eyebrow}</p>
      <h2 class="display-2 book-feature__title">
        {book.title.split("\n").map((line) => <span class="book-feature__line">{line}</span>)}
      </h2>
      <p class="book-feature__name">Emmanuel Cobbi · Author</p>
      <p class="book-feature__subtitle">{book.subtitle}</p>
      <p class="book-feature__body">{book.description}</p>
      <div class="actions book-feature__actions">
        <a class="pill pill--light" href={book.cta.href} rel="noopener">{book.cta.label}</a>
      </div>
      <p class="book-feature__note">{book.note}</p>
    </div>
  </div>
</section>

<style>
  .book-section {
    padding-block: clamp(3.5rem, 6vw, 5.5rem);
  }

  .book-section :global(.book-feature) {
    display: grid;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
  }

  .book-feature__art {
    width: min(100%, 17rem);
    justify-self: center;
  }

  .book-feature__art img {
    width: 100%;
    height: auto !important;
    object-fit: contain;
  }

  .book-feature__line {
    display: block;
  }

  .book-feature__title {
    margin-top: 1rem;
  }

  .book-feature__name {
    margin-top: 1.2rem;
    font-family: var(--font-display);
    font-size: clamp(1.35rem, 2.6vw, 1.85rem);
    letter-spacing: -0.02em;
    color: #f7f7f7;
  }

  .book-feature__subtitle {
    margin-top: 0.4rem;
    font-size: 0.95rem;
    color: rgba(255, 255, 255, 0.72);
    max-width: 42ch;
  }

  .book-feature__body {
    margin-top: 1.1rem;
    font-size: 1.05rem;
    line-height: 1.7;
    color: rgba(255, 255, 255, 0.86);
    max-width: 46ch;
  }

  .book-feature__actions {
    margin-top: 1.85rem;
  }

  .book-feature__note {
    margin-top: 1rem;
    font-size: 0.85rem;
    color: rgba(255, 255, 255, 0.6);
    max-width: 44ch;
  }

  @media (min-width: 800px) {
    .book-section :global(.book-feature) {
      grid-template-columns: minmax(14rem, 0.5fr) minmax(22rem, 1fr);
    }
  }
</style>
