---
import { nav, profile, contact, socials } from "../content/site";

const currentPath = Astro.url.pathname;
const isHome = currentPath === "/" || currentPath === "";
---

<header class="site-header" data-site-header>
  <nav class="site-nav" aria-label="Site menu">
    <div class="site-nav__bar">
      <a class="nav-logo" href="/" aria-label={`${profile.name} — home`}>
        Emmanuel Cobbi
      </a>

      <div class="site-nav__tools">
        <button
          class="theme-toggle"
          type="button"
          data-theme-toggle
          aria-label="Switch colour theme"
          aria-pressed="false"
        >
          <span aria-hidden="true"></span>
        </button>
        <button
          type="button"
          class="nav-toggle"
          data-menu-toggle
          aria-expanded="false"
          aria-controls="site-menu"
        >
          <span class="sr-only">Open menu</span>
          <span aria-hidden="true"><i></i><i></i></span>
        </button>
      </div>
    </div>

    <div class="mobile-menu" id="site-menu" data-mobile-menu data-open="false">
      <ul class="nav-panel__links">
        {
          nav.map((item) => (
            <li>
              <a href={isHome ? `#${item.href.split("#")[1]}` : `/${item.href}`}>
                <span>{item.label}</span>
              </a>
            </li>
          ))
        }
        <li>
          <a href={contact.whatsappCall} target="_blank" rel="noopener">
            <span>Book a call</span>
          </a>
        </li>
      </ul>
      <div class="nav-panel__footer">
        <div class="nav-panel__socials">
          {
            socials.map((social) => (
              <a href={social.href} target="_blank" rel="me noopener noreferrer">
                ↗ {social.label}
              </a>
            ))
          }
        </div>
        <p class="nav-panel__time"><span data-local-time>--:--:--</span> Local</p>
      </div>
    </div>
  </nav>
</header>
